# Copy this file to ".env" and fill in real values.
# NEVER commit your actual .env file to GitHub.

# Flask secret key - used to sign session cookies. Generate a random one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Set to "production" when deployed (enables secure cookies etc.)
FLASK_ENV=development

# Database URL.
# Local default (SQLite file) - leave unset to use instance/finance.db automatically.
# On Render with a persistent disk, something like:
#   DATABASE_URL=sqlite:////opt/render/project/data/finance.db
# Or for managed Postgres:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Google Gemini API key - get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name (optional, defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Port (Render sets this automatically; used for local runs too)
PORT=5000
